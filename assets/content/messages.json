    "late_night": "23:00-04:59"
  },
  "home": [
    { "id": "h_first_1", "context": ["first_open"], "energy": [1, 2, 3], "category": "plant", "text": "만나서 반가워요. 오늘은 {name.이가} 우리 집에 온 첫날이에요." },
    { "id": "h_first_2", "context": ["first_open"], "energy": [1, 2, 3], "category": "plant", "text": "오늘 할 일은 딱 하나예요. 씨앗을 심고 물을 주는 것." },
    { "id": "h_first_3", "context": ["first_open"], "energy": [1, 2, 3], "category": "plant", "text": "{name.와과} 함께하는 첫 페이지예요. 천천히 시작해요." },

    { "id": "h_m1_1", "context": ["morning"], "energy": [1], "category": "body", "text": "좋은 아침이에요. 여기까지 온 것만으로도 오늘 몫은 했어요." },
    { "id": "h_m1_2", "context": ["morning"], "energy": [1], "category": "plant", "text": "아침이 무거운 날이네요. {name} 물만 갈아볼까요? 1분이면 돼요." },
    { "id": "h_m1_3", "context": ["morning"], "energy": [1], "category": "body", "text": "오늘은 천천히 가요. 커튼만 살짝 열어볼래요?" },
    { "id": "h_m1_4", "context": ["morning"], "energy": [1], "category": "body", "text": "눈 뜬 것부터가 시작이에요. 물 한 컵이면 충분해요." },
    { "id": "h_m1_5", "context": ["morning"], "energy": [1], "category": "plant", "text": "{name.은는} 오늘도 조용히 자라고 있어요. 얼굴만 보고 가도 돼요." },
    { "id": "h_m2_1", "context": ["morning"], "energy": [2], "category": "body", "text": "좋은 아침이에요. 커튼 열고 {name.와과} 같이 햇빛 3분 받아볼까요?" },
    { "id": "h_m2_2", "context": ["morning"], "energy": [2], "category": "plant", "text": "물 한 컵 마시고 {name}에게도 물 한 번. 둘 다 목마를 시간이에요." },
    { "id": "h_m2_3", "context": ["morning"], "energy": [2], "category": "plant", "text": "세수 한 번 하고 {name} 사진 찍어볼래요? 어제보다 자랐을지도 몰라요." },
    { "id": "h_m2_4", "context": ["morning"], "energy": [2], "category": "space", "text": "아침에 작은 거 하나 해두면 하루가 어떤지, 오늘 같이 확인해봐요." },
    { "id": "h_m3_1", "context": ["morning"], "energy": [3], "category": "body", "text": "기운이 있는 아침이네요. 창문 열고 5분 환기해볼까요? {name}도 바람을 좋아해요." },
    { "id": "h_m3_2", "context": ["morning"], "energy": [3], "category": "body", "text": "오늘 같은 아침엔 집 앞 5분 산책 어때요? 다녀와서 {name} 얼굴 봐요." },
    { "id": "h_m3_3", "context": ["morning"], "energy": [3], "category": "space", "text": "이불 정리 하나로 아침을 열어볼래요? 하고 나서 어떤지 기록해봐요." },

    { "id": "h_a1_1", "context": ["afternoon"], "energy": [1], "category": "body", "text": "오후까지 온 것도 해낸 거예요. 물 한 컵만 마셔볼까요?" },
    { "id": "h_a1_2", "context": ["afternoon"], "energy": [1], "category": "plant", "text": "잠깐 {name} 얼굴 보러 왔네요. 오늘은 보는 것만으로 충분해요." },
    { "id": "h_a1_3", "context": ["afternoon"], "energy": [1], "category": "body", "text": "기지개 한 번만 켜볼까요? 1분이면 돼요." },
    { "id": "h_a1_4", "context": ["afternoon"], "energy": [1], "category": "space", "text": "지금 할 수 있는 가장 작은 거 하나만 골라봐요. 안 골라도 괜찮아요." },
    { "id": "h_a2_1", "context": ["afternoon"], "energy": [2], "category": "space", "text": "책상 위 컵 하나만 싱크대로 옮겨볼래요? 생각보다 개운할 수도 있어요." },
    { "id": "h_a2_2", "context": ["afternoon"], "energy": [2], "category": "space", "text": "바닥에 있는 물건 다섯 개만 제자리에. 하고 나서 어땠는지 같이 봐요." },
    { "id": "h_a2_3", "context": ["afternoon"], "energy": [2], "category": "connection", "text": "누군가에게 이모티콘 하나 보내볼래요? 말은 없어도 돼요." },
    { "id": "h_a2_4", "context": ["afternoon"], "energy": [2], "category": "plant", "text": "{name.을를} 창가로 옮기면서 나도 햇볕 조금 받아볼까요?" },
    { "id": "h_a3_1", "context": ["afternoon"], "energy": [3], "category": "body", "text": "오늘 같은 날엔 10분 산책 어때요? 다녀와서 {name.이가} 얼마나 컸는지 봐요." },
    { "id": "h_a3_2", "context": ["afternoon"], "energy": [3], "category": "connection", "text": "안부 한 줄 보내볼래요? 짧아도 충분해요." },
    { "id": "h_a3_3", "context": ["afternoon"], "energy": [3], "category": "space", "text": "타이머 10분 맞추고 방 정리 한번 해볼까요? 10분이 지나면 멈춰도 돼요." },

    { "id": "h_e1_1", "context": ["evening"], "energy": [1], "category": "plant", "text": "하루 수고했어요. 오늘은 기록 하나만 남기고 쉬어요." },
    { "id": "h_e1_2", "context": ["evening"], "energy": [1], "category": "plant", "text": "저녁이에요. {name} 물 갈기 하나면 오늘 돌봄은 끝이에요." },
    { "id": "h_e1_3", "context": ["evening"], "energy": [1], "category": "body", "text": "오늘 하루, 버틴 것도 하나의 일이었어요." },
    { "id": "h_e1_4", "context": ["evening"], "energy": [1], "category": "body", "text": "따뜻한 차나 물 한 잔 어때요? 그거면 충분해요." },
    { "id": "h_e2_1", "context": ["evening"], "energy": [2], "category": "body", "text": "저녁 먹었어요? 간단한 거라도 하나 챙겨 먹어볼까요?" },
    { "id": "h_e2_2", "context": ["evening"], "energy": [2], "category": "sleep", "text": "내일 입을 옷 하나만 꺼내둘래요? 내일의 나를 위한 작은 준비예요." },
    { "id": "h_e2_3", "context": ["evening"], "energy": [2], "category": "plant", "text": "{name} 물 갈고 나도 세수 한 번. 하루를 정리하는 느낌이 들 수도 있어요." },
    { "id": "h_e2_4", "context": ["evening"], "energy": [2], "category": "sleep", "text": "내일 아침 알람 하나 맞춰둘까요?" },
    { "id": "h_e3_1", "context": ["evening"], "energy": [3], "category": "space", "text": "기운이 남았다면 이불 한 번 펴볼까요? 누울 때 느낌이 다를 거예요." },
    { "id": "h_e3_2", "context": ["evening"], "energy": [3], "category": "connection", "text": "오늘 {name} 사진, 누군가에게 보내볼래요? 자란 걸 자랑해도 돼요." },
    { "id": "h_e3_3", "context": ["evening"], "energy": [3], "category": "connection", "text": "짧게 통화 한 통 어때요? 5분이면 충분해요." },

    { "id": "h_n_1", "context": ["late_night"], "energy": [1, 2, 3], "category": "sleep", "text": "늦은 시간이네요. 오늘은 휴대폰 내려놓고 눕는 게 제일 좋은 돌봄이에요." },
    { "id": "h_n_2", "context": ["late_night"], "energy": [1, 2, 3], "category": "sleep", "text": "{name}도 자는 시간이에요. 우리도 불 끄고 쉬어요." },
    { "id": "h_n_3", "context": ["late_night"], "energy": [1, 2, 3], "category": "sleep", "text": "밤에는 생각이 커지기 쉬워요. 내일 아침에 {name.와과} 다시 만나요." },
    { "id": "h_n_4", "context": ["late_night"], "energy": [1, 2, 3], "category": "sleep", "text": "지금은 아무것도 안 해도 돼요. 눈만 감아봐요." },

    { "id": "h_r_1", "context": ["return_after_absence"], "energy": [1, 2, 3], "category": "plant", "text": "다시 와줘서 반가워요. 오늘은 둘러보기만 해도 돼요." },
    { "id": "h_r_2", "context": ["return_after_absence"], "energy": [1, 2, 3], "category": "plant", "text": "언제 와도 괜찮아요. 여기는 그대로 있어요." },
    { "id": "h_r_3", "context": ["return_after_absence"], "energy": [1, 2, 3], "category": "plant", "text": "오랜만이에요. 새로 시작하는 건 3분이면 돼요. 이전 기록은 앨범에 그대로 있어요." },
    { "id": "h_r_4", "context": ["return_after_absence"], "energy": [1, 2, 3], "category": "plant", "text": "돌아온 것 자체가 다시 시작이에요. 오늘은 사진 한 장이면 충분해요." },

    { "id": "h_g_1", "context": ["germination_day"], "energy": [1, 2, 3], "category": "plant", "text": "{name}에게서 싹이 텄어요! 처음 보는 초록이에요." },
    { "id": "h_g_2", "context": ["germination_day"], "energy": [1, 2, 3], "category": "plant", "text": "뿌리가 나왔어요. 보이지 않는 곳에서 먼저 자라고 있었네요." },
    { "id": "h_g_3", "context": ["germination_day"], "energy": [1, 2, 3], "category": "plant", "text": "작은 싹이 올라왔어요. 물을 갈아준 날들이 여기 다 들어 있어요." },

    { "id": "h_h_1", "context": ["harvest_day"], "energy": [1, 2, 3], "category": "plant", "text": "오늘 수확해도 돼요! 직접 키운 새싹으로 계란볶음 어때요?" },
    { "id": "h_h_2", "context": ["harvest_day"], "energy": [1, 2, 3], "category": "plant", "text": "{name.이가} 다 자랐어요. 며칠 동안 직접 키운 거예요." },
    { "id": "h_h_3", "context": ["harvest_day"], "energy": [1, 2, 3], "category": "plant", "text": "수확하는 날이에요. 키운 걸 먹어보는 건 생각보다 특별한 경험일 거예요." },

    { "id": "h_c_1", "context": ["new_chapter"], "energy": [1, 2, 3], "category": "plant", "text": "새 챕터를 시작해요. 한 번 해봤으니 이번엔 조금 더 익숙할 거예요." },
    { "id": "h_c_2", "context": ["new_chapter"], "energy": [1, 2, 3], "category": "plant", "text": "새 씨앗을 심는 날이에요. {name}의 새 이야기를 시작해봐요." },

    { "id": "h_w_1", "context": ["weekly_goal_met"], "energy": [1, 2, 3], "category": "plant", "text": "이번 주 정원을 다 채웠어요. 남은 날은 마음 편히 쉬어도 돼요." },
    { "id": "h_w_2", "context": ["weekly_goal_met"], "energy": [1, 2, 3], "category": "plant", "text": "이번 주 목표만큼 돌봤어요. 정원이 초록으로 찼어요." },

    { "id": "h_mo_1", "context": ["mold_check"], "energy": [1, 2, 3], "category": "plant", "text": "하얀 게 보이면 물을 살짝 뿌려봐요. 사라지면 뿌리털이에요." },
    { "id": "h_mo_2", "context": ["mold_check"], "energy": [1, 2, 3], "category": "plant", "text": "곰팡이라면 새로 시작하면 돼요. 처음 키우는 사람 누구나 겪는 일이에요." },

    { "id": "h_rs_1", "context": ["restart"], "energy": [1, 2, 3], "category": "plant", "text": "새로 시작하는 것도 키우는 과정이에요. 이전 기록은 앨범에 그대로 있어요." },
    { "id": "h_rs_2", "context": ["restart"], "energy": [1, 2, 3], "category": "plant", "text": "다시 심어볼까요? 이번엔 물 갈기 알림을 같이 챙겨볼게요." },

    { "id": "h_l_1", "context": ["level_up_suggest"], "energy": [1, 2, 3], "category": "plant", "text": "새싹 키우기에 익숙해진 것 같아요. 다음 식물을 만나볼래요? 지금 단계에 더 머물러도 좋아요." }
  ],
  "personal": [
    { "id": "p_1", "requires": ["action", "delta"], "text": "지난번 {action.을를} 한 날, 기분이 {delta}점 올랐었어요. 오늘도 해볼까요?" },
    { "id": "p_2", "requires": ["action", "count"], "text": "'{action}', 벌써 {count}번 했어요. 몸이 기억하기 시작했을 거예요." },
    { "id": "p_3", "requires": ["name", "day", "care_days"], "text": "{name.은는} {day}일째 자라는 중이에요. 그동안 {care_days}번 돌봤어요." },
    { "id": "p_4", "requires": ["action"], "text": "이번 주 기록을 보니 '{action}' 한 날이 가장 편안했어요." },
    { "id": "p_5", "requires": ["care_days"], "text": "지금까지 {care_days}번 돌봤어요. 그 하루하루가 다 앨범에 있어요." },
    { "id": "p_6", "requires": ["action"], "text": "'{action}' 하고 나면 대체로 조금 가벼워졌다고 기록했어요. 오늘도 실험해볼까요?" },
    { "id": "p_7", "requires": ["name", "care_days"], "text": "어제도 {name} 물을 갈았네요. 그런 날이 {care_days}일 쌓였어요." }
  ],
  "afterAction": {
    "positive": [
      { "id": "aa_p_1", "text": "기분이 {delta}점 올랐네요. 잎 하나로 남겨둘게요." },
      { "id": "aa_p_2", "text": "해보니 조금 달라졌네요. 이 행동, 기억해둘게요." },
      { "id": "aa_p_3", "text": "작은 행동 하나가 이만큼 움직였어요." },
      { "id": "aa_p_4", "text": "좋아요. 나한테 맞는 행동일지도 몰라요." }
    ],
    "zero": [
      { "id": "aa_z_1", "text": "변화가 없어도 괜찮아요. 해본 것 자체가 기록이에요." },
      { "id": "aa_z_2", "text": "마음은 그대로여도 몸은 한 걸음 움직였어요." },
      { "id": "aa_z_3", "text": "오늘은 그대로네요. 그래도 잎 하나는 자랐어요." }
    ],
    "negative": [
      { "id": "aa_n_1", "text": "오히려 지쳤다면 오늘은 여기까지 해요. 알려줘서 고마워요." },
      { "id": "aa_n_2", "text": "이 행동이 오늘은 안 맞았나 봐요. 다음엔 다른 걸 제안할게요." },
      { "id": "aa_n_3", "text": "솔직하게 기록해줘서 고마워요. 그것도 중요한 정보예요." }
    ],
    "skipped": [
      { "id": "aa_s_1", "text": "괜찮아요. 골라본 것만으로도 충분했어요." },
      { "id": "aa_s_2", "text": "알겠어요. 다음에 또 물어볼게요." }
    ],
    "chain": [
      { "id": "aa_c_1", "text": "하나 더 해볼래요? 다음 칸은 '{next}'예요. 여기서 멈춰도 충분해요." },
      { "id": "aa_c_2", "text": "기운이 남았다면 '{next}'도 있어요. 안 해도 오늘은 이미 해냈어요." }
    ]
  },
  "rest": [
    { "id": "r_1", "text": "쉬는 것도 돌봄이에요. 오늘은 여기까지 해요." },
    { "id": "r_2", "text": "알겠어요. {name.은는} 오늘 조용히 자라고 있을게요." },
    { "id": "r_3", "text": "쉬기로 한 것도 기록해둘게요. 내 상태를 아는 것도 중요하니까요." },
    { "id": "r_4", "text": "오늘은 아무것도 안 해도 괜찮은 날이에요." },
    { "id": "r_5", "text": "푹 쉬어요. 내일 또 만나요." }
  ],
  "support": [
    { "id": "s_1", "text": "요즘 많이 힘든 것 같아요. 오늘은 아무것도 안 해도 돼요." },
    { "id": "s_2", "text": "혼자 버티지 않아도 돼요. 언제든 이야기할 곳이 있어요." },
    { "id": "s_3", "text": "{name.은는} 잠시 혼자서도 괜찮아요. 지금은 스스로를 먼저 챙길 때예요." },
    { "id": "s_4", "text": "말하기 어려운 마음이 있다면 109에 전화하거나 문자로 이야기할 수 있어요. 24시간 열려 있어요." },
