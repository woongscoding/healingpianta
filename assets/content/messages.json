  "contexts": ["first_open", "morning", "afternoon", "evening", "late_night", "return_after_absence", "germination_day", "harvest_day", "new_chapter", "weekly_goal_met", "mold_check", "restart", "level_up_suggest"],
  "timeRanges": {
    "morning": "05:00-11:59",
    "afternoon": "12:00-17:59",
